use_proxy() {
  local proxy_url=$1
  local no_proxy_addresses=${2-localhost,127.0.0.0/8}

  export http_proxy=$proxy_url
  export https_proxy=$proxy_url
  export HTTP_PROXY=$proxy_url
  export HTTPS_PROXY=$proxy_url

  export no_proxy=$no_proxy_addresses
  export NO_PROXY=$no_proxy_addresses
}
